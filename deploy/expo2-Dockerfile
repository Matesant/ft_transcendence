# Espelho do Dockerfile.prod do grupo, com REACT_APP_API_URL como build arg.
# Destino: /root/expo2/Frontend/Dockerfile.expo
#
# Necessário porque o Create React App inlina process.env.REACT_APP_* no bundle
# em tempo de build, e o Dockerfile.prod original não declara nenhum ARG.
#
# Por que a variável precisa estar definida: o frontend tem DUAS fontes de URL
# com fallbacks diferentes quando ela está ausente —
#   services/api.js            -> cai em '/api' (relativo, mesma origem)  OK
#   hooks/usePresenceWebSocket -> cai em 'https://localhost:8082'         quebra
# então o WebSocket de presença tentava wss://localhost:8082/ws.
#
# O valor https://expo2.42sp.org.br/api satisfaz os dois:
#   api.js  -> https://expo2.42sp.org.br/api/auth/login
#   hook    -> wss://expo2.42sp.org.br/api/ws?token=...
# e o location /api/ do nginx já remove o prefixo e repassa o upgrade, então o
# backend recebe /auth/login e /ws como espera.

FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .

ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL
RUN npm run build

FROM nginx:latest

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
