# Build de produção do frontend do expo4, servido por nginx.
# Destino: /root/expo4/Front/Dockerfile.expo
#
# O Dockerfile original do grupo roda o dev server do Vite (`npm run dev --host`)
# na 5173. Para uma expo atrás de proxy isso traz dois problemas: o Vite 7 recusa
# requisições cujo Host não está em server.allowedHosts, e o cliente de HMR fica
# tentando abrir um WebSocket que não existe, enchendo o console de erro.
# Bundle estático resolve os dois.
#
# Usa `npx vite build` em vez de `npm run build` de propósito: o script do grupo
# é `tsc && vite build`, e o `tsc` falha com 11 erros de tipo (variáveis não
# usadas e index signatures implícitas). O Vite compila via esbuild, que remove
# os tipos sem checá-los, então o bundle sai correto sem eu ter que mexer no
# TypeScript de outro grupo.
#
# VITE_API_URL entra como build arg porque o Vite inlina import.meta.env no
# bundle em tempo de build — não é lido em runtime.

FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npx vite build

FROM nginx:alpine

COPY nginx.expo4.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
