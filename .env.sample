# ============================================
# OBRIGATÓRIAS — sem elas os serviços não sobem
# ============================================

# Compartilhado pelos 4 serviços: precisa ser o MESMO valor em todos, senão um
# serviço não valida o token emitido por outro.
# match/user/game não têm fallback: ausente = falha no boot.
JWT_SECRET=your_secure_jwt_secret_here
COOKIE_SECRET=your_secure_cookie_secret_here

# Caminho do SQLite de cada serviço. O plugin de db lança
# "DB_PATH is not defined in .env" se faltar.
# O compose renomeia estas para DB_PATH dentro de cada container.
AUTH_DB_PATH=./data/auth-service.db
USER_DB_PATH=./data/user-service.db
MATCH_DB_PATH=./data/match-service.db

# ============================================
# RECOMENDADAS
# ============================================

# Em 'development' o cookie de autenticação sai SEM a flag Secure, e as respostas
# de erro incluem stack trace. Use 'production' em deploy exposto.
NODE_ENV=development

# ============================================
# OPCIONAIS — o stack sobe sem elas, features específicas ficam quebradas
# ============================================

# Login com Google. Sem isso /auth/google ainda redireciona, mas com client_id
# vazio — quem recusa é a tela do Google, não o serviço.
# O redirect_uri é derivado do host da requisição; cadastre no Cloud Console:
#   https://<seu-dominio>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio de e-mail (2FA e reset de senha), via Gmail. Precisa ser uma
# "App Password", não a senha da conta. O boot não falha sem isso — só o envio.
# O compose renomeia estas para MAIL_USER/MAIL_PASS.
AUTH_MAIL_USER=your-gmail@gmail.com
AUTH_MAIL_PASS=your-app-password-here

# Host principal do deploy (IP da máquina ou "localhost").
# Frontend e APIs rodam na mesma origem, então isto NÃO afeta o roteamento:
# alimenta apenas a lista de CORS, que é rede de segurança para quem bater
# direto nas portas 3001-3004. Escrita pelo ft_transcendence.sh setup.
IP=localhost

# Hosts extras aceitos pelo CORS, separados por vírgula.
# localhost e 127.0.0.1 já entram sempre.
ALLOWED_HOSTS=expo3.42sp.org.br

# Porta do frontend usada para montar as origens de CORS (443 omite a porta).
FRONTEND_PORT=8080

# Porta do game-service (default 3004).
# PORT=3004
